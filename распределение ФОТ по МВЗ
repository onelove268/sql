WITH empl_no_mvz AS ( -- таблица сотрудников сейлз без разбивки на МВЗ
    SELECT DISTINCT
        empl_date,
        DATE_TRUNC('month', empl_date) AS month,
        ech.project_id,
        ech.project_name,
        CASE
            WHEN ech.project_id = '297d6376-8e3c-0ad7-05f5-b08f0074a873' THEN 29
            WHEN ech.role_empl_part IS NULL THEN 100
            ELSE ech.role_empl_part
        END AS role_empl_part,
        COUNT(*) AS day
    FROM 
        fin_reports.empl_circles_history ech
    WHERE 
        empl_date BETWEEN '2024-01-01 00:00:00' AND '2024-12-31 23:59:59'
        AND ech.mvz = '100 | Sales'
    GROUP BY empl_date, month, project_id, project_name, role_empl_part
),
empl_day_no_mvz AS ( -- подсчет количества отработанных дней в месяце
    SELECT
        month,
        project_id,
        project_name,
        COUNT(day) AS e_day,
        EXTRACT(DAY FROM (DATE_TRUNC('month', month) + INTERVAL '1 month - 1 day')) AS days_in_month,
        role_empl_part
    FROM empl_no_mvz enm
    GROUP BY month, project_id, project_name, role_empl_part
),
empl_mvz AS ( -- таблица сотрудников сейлз с разбивкой по МВЗ
    SELECT DISTINCT 
        empl_date,
        DATE_TRUNC('month', empl_date) AS month,
        ech.project_id,
        ech.project_name,
        ech.mvz,
        ech.circle_1,
        ech.circle_2,
        COUNT(*) AS day_mvz
    FROM 
        fin_reports.empl_circles_history ech
    WHERE 
        empl_date BETWEEN '2024-01-01 00:00:00' AND '2024-12-31 23:59:59'
        AND ech.mvz = '100 | Sales'
    GROUP BY empl_date, month, project_id, project_name, mvz, circle_1, circle_2
),
empl_day_mvz AS ( -- подсчет количества отработанных дней в месяце по МВЗ
    SELECT 
        em.month,
        em.project_id,
        em.project_name,
        em.mvz,
        em.circle_1,
        em.circle_2,
        COUNT(em.day_mvz) AS day_mvz,
        EXTRACT(DAY FROM (DATE_TRUNC('month', em.month) + INTERVAL '1 month - 1 day')) AS days_in_month,
        enm.role_empl_part,
        CASE 
            WHEN COUNT(em.day_mvz) = 0 THEN 0
            WHEN em.project_id = '2ebd42a6-3c58-3f04-e1a6-b118007bbd66' 
                 AND em.month = '2024-11-01 00:00:00' THEN
                CASE 
                    WHEN em.circle_2 = '156 | New Logos 5' AND enm.role_empl_part = 50 THEN 0.633333333333333
                    WHEN em.circle_2 = '156 | New Logos 5' AND enm.role_empl_part = 100 THEN 0.366666666666667
                    WHEN em.circle_2 = '155 | New Logos 4' AND enm.role_empl_part = 50 THEN 0.633333333333333
                    WHEN em.circle_2 = '155 | New Logos 4' AND enm.role_empl_part = 100 THEN 0
                    ELSE (COUNT(em.day_mvz)::FLOAT / EXTRACT(DAY FROM (DATE_TRUNC('month', em.month) + INTERVAL '1 month - 1 day')))
                end
            when COUNT(em.day_mvz) = enm.e_day then 1
            ELSE (COUNT(em.day_mvz)::FLOAT / EXTRACT(DAY FROM (DATE_TRUNC('month', em.month) + INTERVAL '1 month - 1 day')))
        END AS percentage
    FROM empl_mvz em
    JOIN empl_day_no_mvz enm 
        ON em.month = enm.month 
        AND em.project_id = enm.project_id 
        AND em.project_name = enm.project_name
    GROUP BY em.month, em.project_id, em.project_name, em.mvz, em.circle_1, em.circle_2, enm.role_empl_part, enm.e_day
),
fot_total AS (
    SELECT DISTINCT 
        project_id, project_name, project_stage, 
        year, 
       jan_fot, jan_bonus, jan_other, jan_insure, 
       feb_fot, feb_bonus, feb_other, feb_insure, 
       mar_fot, mar_bonus, mar_other, mar_insure, 
       apr_fot, apr_bonus, apr_other, apr_insure, 
       may_fot, may_bonus, may_other, may_insure, 
       jun_fot, jun_bonus, jun_other, jun_insure, 
       jul_fot, jul_bonus, jul_other, jul_insure, 
       aug_fot, aug_bonus, aug_other, aug_insure, 
       sep_fot, sep_bonus, sep_other, sep_insure, 
