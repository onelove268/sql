                            # Применяем округление
                            result_data['Сумма с учетом занятости'] = result_data['Сумма с учетом занятости'].round(2)

                            # Корректируем суммы для каждого сотрудника
                            adjusted_data = []
                            corrections_made = 0

                            for employee in result_data['ФИО'].unique():
                                employee_data = result_data[result_data['ФИО'] == employee].copy()
                                original_salary = employee_data['Сумма'].iloc[0]

                                # Проверяем общую сумму распределения
                                total_distributed = employee_data['Сумма с учетом занятости'].sum()
                                difference = round(original_salary - total_distributed, 2)

                                if abs(difference) > 0.01:
                                    # Корректируем в периоде с наибольшим количеством дней
                                    adjust_index = employee_data['Кол-во дней'].idxmax()
                                    employee_data.loc[adjust_index, 'Сумма с учетом занятости'] += difference
                                    employee_data.loc[adjust_index, 'Сумма с учетом занятости'] = round(
