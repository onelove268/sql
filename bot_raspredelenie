# Функция для правильного склонения слова "сотрудник"
def get_employee_text(count):
    if count % 10 == 1 and count % 100 != 11:
        return f"{count} сотрудник"
    elif count % 10 in [2, 3, 4] and count % 100 not in [12, 13, 14]:
        return f"{count} сотрудника"
    else:
        return f"{count} сотрудников"

# Функция для расчета количества дней в периоде
def calculate_days(start_date, end_date):
    """Рассчитывает количество дней между датами (включая обе даты)"""
    return (end_date - start_date).days + 1

# Функция для распределения суммы по периодам с упрощенной логикой
def distribute_by_periods_simple(salary_data, distribution_data):
    """
    Распределяет зарплату с учетом смены кругов в течение периода.
    Сохраняет корректность общей суммы ФОТ по сотруднику.
    """
    result_rows = []

    for _, salary_row in salary_data.iterrows():
        employee = salary_row['Сотрудник']
        total_salary = salary_row['ФОТ']
        salary_start = salary_row['Дата начала']
        salary_end = salary_row['Дата окончания']
        total_days = calculate_days(salary_start, salary_end)
        daily_salary = total_salary / total_days

        # Выбираем все распределения для этого сотрудника
        emp_distributions = distribution_data[distribution_data['Сотрудник'] == employee].copy()
        if emp_distributions.empty:
            st.warning(f"⚠️ Для сотрудника {employee} не найдено распределение")
            continue

        emp_distributions = emp_distributions.sort_values('Дата начала')

        temp_rows = []

        # Для каждого распределения создаём период
        for _, dist_row in emp_distributions.iterrows():
            period_start = max(dist_row['Дата начала'], salary_start)
            period_end = salary_end
            period_days = calculate_days(period_start, period_end)
            period_salary = daily_salary * period_days

            exclude_columns = ['Сотрудник', '% занятости', 'Дата начала']
            circle_columns = [col for col in distribution_data.columns if col not in exclude_columns]

            result_row = {
                'ФИО': employee,
                'Сумма': total_salary,
                'Период выплаты': f"{salary_start.strftime('%d.%m.%Y')} - {salary_end.strftime('%d.%m.%Y')}",
                'Период распределения': f"{period_start.strftime('%d.%m.%Y')} - {period_end.strftime('%d.%m.%Y')}",
                'Кол-во дней': period_days,
                '% занятости': dist_row['% занятости'],
                'Сумма с учетом занятости': round(period_salary * dist_row['% занятости'] / 100, 2)
            }

            for col in circle_columns:
                result_row[col] = dist_row[col]

            temp_rows.append(result_row)

        # Корректируем сумму по сотруднику
        df_temp = pd.DataFrame(temp_rows)
        distributed_sum = df_temp['Сумма с учетом занятости'].sum()
        difference = round(total_salary - distributed_sum, 2)
        if abs(difference) > 0.01:
            # Добавляем разницу в период с наибольшим количеством дней
            idx_max_days = df_temp['Кол-во дней'].idxmax()
            df_temp.loc[idx_max_days, 'Сумма с учетом занятости'] += difference
            df_temp.loc[idx_max_days, 'Сумма с учетом занятости'] = round(df_temp.loc[idx_max_days, 'Сумма с учетом занятости'], 2)

        result_rows.extend(df_temp.to_dict('records'))

    return pd.DataFrame(result_rows)

