    if st.session_state.salary_data is not None and st.session_state.distribution_data is not None:
        # Проверяем наличие необходимых колонок
        required_salary_columns = ['Сотрудник', 'ФОТ', 'Дата начала', 'Дата окончания']
        required_distribution_columns = ['Сотрудник', '% занятости', 'Дата начала']

